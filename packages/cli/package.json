{
  "name": "@flowindex/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "FlowIndex CLI — query Flow blockchain data from the terminal",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flowindex": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@flowindex/api-client": "workspace:*",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
