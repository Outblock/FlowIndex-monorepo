bundler.flowindex.io {
	# Testnet bundler (chain 545)
	handle /545/rpc* {
		reverse_proxy localhost:4337
	}

	# Mainnet bundler (chain 747)
	handle /747/rpc* {
		reverse_proxy localhost:4347
	}

	# Testnet paymaster (chain 545)
	handle /545/paymaster* {
		reverse_proxy localhost:4338
	}

	# Mainnet paymaster (chain 747)
	handle /747/paymaster* {
		reverse_proxy localhost:4348
	}

	# Health check
	handle /health {
		respond "OK" 200
	}

	# Default: 404
	handle {
		respond "Not found. Use /{chainId}/rpc or /{chainId}/paymaster" 404
	}
}
